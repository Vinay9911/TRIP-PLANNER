# Frontend configuration. Copy to `.env.local`.
#
# Everything here is NEXT_PUBLIC_ and therefore visible in the browser bundle.
# That is correct for all of these: the Supabase anon key is designed to be
# public and is constrained by row level security, the API URL is not a secret,
# and a Mapbox public token is scoped to exactly that. Never put the
# service_role key here - it bypasses RLS entirely.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_API_URL=http://localhost:8000

# Map tiles. Free tier at https://account.mapbox.com/access-tokens/ - 50,000
# map loads a month, no card required. Optional: without it every other part of
# the interface works and the map area simply stays blank, which is a
# deliberate degradation rather than a crash.
#
# Several comma-separated tokens are accepted and one is picked per session, so
# a demo shared with a group does not put every viewer on one token's quota.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# -----------------------------------------------------------------------------
# Shared demo account (optional)
# -----------------------------------------------------------------------------
# Set these and EVERY visitor signs in as the same user, so they all see the
# same conversations, the same remembered preferences and the same trips. That
# is what you want for a demonstration: a reviewer opening the link finds the
# work already there instead of an empty workspace.
#
# It also means there is no privacy between visitors, because there is only one
# account - which is the correct trade when the entire point is that everyone
# sees the same thing, and the wrong one everywhere else.
#
# LEAVE THESE BLANK for real use. Each visitor then gets their own anonymous
# identity and sees only their own trips (requires "Allow anonymous sign-ins"
# in Supabase -> Authentication -> Sign In / Providers).
#
# Create the account with an email and password in Supabase, then paste them
# here. The password is visible in the browser bundle by design; it protects
# nothing that the page does not already offer anyone who opens it.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
