# Frontend configuration. Copy to `.env.local`.
#
# Everything here is NEXT_PUBLIC_ and therefore visible in the browser bundle.
# That is correct for all three values: the Supabase anon key is designed to be
# public and is constrained by row level security, and the API URL is not a
# secret. Never put the service_role key here - it bypasses RLS entirely.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_API_URL=http://localhost:8000
