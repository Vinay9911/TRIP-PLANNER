# Frontend configuration. Copy to `.env.local`.
#
# Everything here is NEXT_PUBLIC_ and therefore visible in the browser bundle.
# That is correct for all of these: the Supabase anon key is designed to be
# public and is constrained by row level security, the API URL is not a secret,
# and a Mapbox public token is scoped to exactly that. Never put the
# service_role key here - it bypasses RLS entirely.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_API_URL=http://localhost:8000

# Map tiles. Free tier at https://account.mapbox.com/access-tokens/ - 50,000
# map loads a month, no card required. Optional: without it every other part of
# the interface works and the map area simply stays blank, which is a
# deliberate degradation rather than a crash.
#
# Several comma-separated tokens are accepted and one is picked per session, so
# a demo shared with a group does not put every viewer on one token's quota.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
