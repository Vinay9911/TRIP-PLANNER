# =============================================================================
# Trip Planner Agent - environment configuration
# =============================================================================
# Copy to `.env` and fill in. Never commit the filled-in file.
#
#   cp .env.example .env
#
# Every variable below is listed with WHERE TO GET IT. All services used by
# the default configuration have a free tier that requires no credit card.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. LLM - Groq
# -----------------------------------------------------------------------------
# Sign up: https://console.groq.com  ->  API Keys  ->  Create API Key
# Free tier: ~30 requests/min, ~1,000 requests/day. No credit card.
GROQ_API_KEY=gsk_your_key_here

# Model tiering. The agent uses different models for different jobs so that the
# free-tier request budget is spent where reasoning quality actually matters.
# See docs/adr/0002-model-tiering.md for the rationale.
LLM_PLANNER_MODEL=openai/gpt-oss-120b
LLM_EXECUTOR_MODEL=llama-3.3-70b-versatile
LLM_UTILITY_MODEL=llama-3.1-8b-instant

# Sampling. Planning is kept near-deterministic; prose gets a little freedom.
LLM_PLANNER_TEMPERATURE=0.1
LLM_RESPONDER_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=60


# -----------------------------------------------------------------------------
# 2. Embeddings - Google Gemini
# -----------------------------------------------------------------------------
# Sign up: https://aistudio.google.com/apikey  ->  Create API key
# Free tier available, no credit card. Used to embed long-term memories and
# RAG chunks. Chosen for its multilingual quality - it lets a preference
# stated in one language be retrieved by a query in another.
GEMINI_API_KEY=your_gemini_key_here
EMBEDDING_MODEL=gemini-embedding-001
# Matryoshka truncation: 768 keeps the pgvector index small without a
# meaningful quality loss at our corpus size.
EMBEDDING_DIMENSIONS=768


# -----------------------------------------------------------------------------
# 3. Database + Auth - Supabase
# -----------------------------------------------------------------------------
# Sign up: https://supabase.com  ->  New project (free tier).
#
#   SUPABASE_URL              Project Settings -> Data API -> Project URL
#   SUPABASE_ANON_KEY         Project Settings -> API Keys -> anon / public
#   SUPABASE_SERVICE_ROLE_KEY Project Settings -> API Keys -> service_role
#                             (SERVER-SIDE ONLY - bypasses row level security)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Postgres connection string, used for pgvector queries and the LangGraph
# checkpointer.  Project Settings -> Database -> Connection string -> URI.
#
# IMPORTANT: use the *session* pooler (port 5432) or the direct connection,
# NOT the transaction pooler (port 6543). The transaction pooler does not
# support the prepared statements the LangGraph checkpointer relies on.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# JWT verification. Supabase signs with asymmetric keys (ES256) by default for
# projects created after Oct 2025; the public keys are fetched from this
# endpoint and cached. Leave as the default unless self-hosting.
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated


# -----------------------------------------------------------------------------
# 4. Tools - external data sources
# -----------------------------------------------------------------------------

# Tavily (live web search)
# Sign up: https://app.tavily.com  ->  free tier, 1,000 credits/month, no card.
TAVILY_API_KEY=tvly-your_key_here

# Geoapify (points of interest / attractions, OpenStreetMap-backed)
# Sign up: https://myprojects.geoapify.com  ->  free tier, 3,000 credits/day.
GEOAPIFY_API_KEY=your_geoapify_key_here

# Open-Meteo (weather) and Wikivoyage (travel guide corpus) need NO API KEY.
# Their base URLs are configurable only for testing/self-hosting.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1
WIKIVOYAGE_API_BASE_URL=https://en.wikivoyage.org/w/api.php

# Flights/hotels. Amadeus Self-Service was decommissioned on 2026-07-17, so the
# default provider is a deterministic mock (explicitly permitted by the brief
# and always labelled `"source": "mock"` in responses).
# Set FLIGHT_PROVIDER=duffel and supply a token to use Duffel's test sandbox.
FLIGHT_PROVIDER=mock
DUFFEL_API_TOKEN=


# -----------------------------------------------------------------------------
# 5. Agent behaviour - safety rails on the planning loop
# -----------------------------------------------------------------------------
# Hard ceilings that stop a runaway agent from burning the daily request quota.
AGENT_MAX_PLAN_STEPS=8
AGENT_MAX_REPLAN_CYCLES=3
AGENT_MAX_TOOL_CALLS_PER_STEP=4
AGENT_STEP_TIMEOUT_SECONDS=90

# Multi-hop RAG: maximum chained retrievals per request.
RAG_MAX_HOPS=4
RAG_CHUNK_TOKENS=512
RAG_TOP_K=6
RAG_CACHE_TTL_DAYS=30

# Long-term memory tuning. See docs/memory.md for what these thresholds mean.
MEMORY_DEDUPE_THRESHOLD=0.90      # >= this cosine similarity -> reinforce, don't insert
MEMORY_CONFLICT_THRESHOLD=0.75    # in [conflict, dedupe) -> ask the LLM to arbitrate
MEMORY_RETRIEVAL_TOP_K=8
MEMORY_MIN_CONFIDENCE=0.6         # candidates below this are discarded


# -----------------------------------------------------------------------------
# 6. Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development           # development | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                # console (human-readable) | json (production)

# Comma-separated list of allowed browser origins for the Next.js frontend.
CORS_ORIGINS=http://localhost:3000

# Per-user request throttle for the chat endpoint.
RATE_LIMIT_REQUESTS_PER_MINUTE=10
